{
  "name": "@farhadarjmand/causal-market-structure",
  "version": "0.1.1",
  "description": "TypeScript market structure: confirmed swings, BOS/CHOCH and heuristic order-block zones with point-in-time availability clocks.",
  "type": "module",
  "license": "MIT",
  "author": "Farhad Arjmand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhad-arjmand/causal-market-structure.git"
  },
  "bugs": {
    "url": "https://github.com/farhad-arjmand/causal-market-structure/issues"
  },
  "homepage": "https://github.com/farhad-arjmand/causal-market-structure#readme",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/API.md",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs && tsc -p test/tsconfig.json",
    "check": "npm test && node examples/basic.mjs && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/smoke-tarball.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "keywords": [
    "typescript",
    "market-structure",
    "ohlc",
    "bos",
    "choch",
    "order-blocks",
    "backtesting",
    "point-in-time",
    "technical-analysis",
    "quantitative-finance"
  ]
}
